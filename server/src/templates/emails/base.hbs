<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f4f6fa; font-family: 'Segoe UI', Arial, sans-serif; color: #1a2238;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f4f6fa; padding: 24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 12px rgba(20, 30, 60, 0.08);">
          <tr>
            <td style="background: linear-gradient(135deg, #b5021a 0%, #7a0112 100%); padding: 28px 32px; color: #ffffff;">
              <p style="margin: 0; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.85;">Albroksa &middot; Canal interno</p>
              <h1 style="margin: 8px 0 0 0; font-size: 22px; font-weight: 600;">{{title}}</h1>
            </td>
          </tr>
          <tr>
            <td style="padding: 28px 32px 8px 32px;">
              <p style="margin: 0 0 16px 0; font-size: 15px; line-height: 1.55;">{{greeting}}</p>
              <p style="margin: 0 0 20px 0; font-size: 15px; line-height: 1.55;">{{intro}}</p>

              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 16px 0 20px 0; border: 1px solid #e3e7f0; border-radius: 8px; overflow: hidden;">
                {{#each fields}}
                <tr>
                  <td style="padding: 10px 14px; background-color: #f8fafd; font-weight: 600; font-size: 13px; color: #4a5680; border-bottom: 1px solid #eef0f6; width: 40%;">{{this.label}}</td>
                  <td style="padding: 10px 14px; font-size: 14px; color: #1a2238; border-bottom: 1px solid #eef0f6;">{{this.value}}</td>
                </tr>
                {{/each}}
              </table>

              {{#if observaciones}}
              <div style="margin: 16px 0 20px 0; padding: 12px 16px; background-color: #fff7ed; border-left: 3px solid #f59e0b; border-radius: 6px;">
                <p style="margin: 0 0 4px 0; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: #92400e; font-weight: 700;">Observaciones</p>
                <p style="margin: 0; font-size: 14px; line-height: 1.5; color: #78350f;">{{observaciones}}</p>
              </div>
              {{/if}}

              {{#if adjuntos.length}}
              <div style="margin: 16px 0 20px 0;">
                <p style="margin: 0 0 8px 0; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: #4a5680; font-weight: 700;">Adjuntos</p>
                <ul style="margin: 0; padding-left: 20px; color: #1a2238; font-size: 14px;">
                  {{#each adjuntos}}
                  <li style="margin: 4px 0;">{{this.nombre_original}}</li>
                  {{/each}}
                </ul>
              </div>
              {{/if}}

              {{#if ctaUrl}}
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 24px 0 8px 0;">
                <tr>
                  <td style="background-color: #b5021a; border-radius: 6px;">
                    <a href="{{ctaUrl}}" target="_blank" style="display: inline-block; padding: 12px 22px; color: #ffffff; text-decoration: none; font-weight: 600; font-size: 14px;">{{ctaLabel}}</a>
                  </td>
                </tr>
              </table>
              {{/if}}
            </td>
          </tr>
          <tr>
            <td style="padding: 20px 32px 28px 32px; border-top: 1px solid #eef0f6;">
              <p style="margin: 0; font-size: 12px; color: #6b7591; line-height: 1.5;">Este mensaje se ha enviado automaticamente desde el canal interno de cotizaciones de Albroksa. Si necesitas mas informacion, responde a este correo.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
